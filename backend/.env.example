# Copy to .env for local runs. On Render, set these in the service's Environment tab.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Postgres connection string (e.g. from Neon). Leave empty locally to use a SQLite file.
DATABASE_URL=
# The service account JSON key (one line) that can read Play purchases. Optional until Kayra Plus is live.
GOOGLE_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=com.kayraapp.kayra
SUPPORT_EMAIL=
FREE_DAILY_LIMIT=30
PLUS_DAILY_LIMIT=300
KAYRA_MODEL=claude-haiku-5-5
PORT=8080
